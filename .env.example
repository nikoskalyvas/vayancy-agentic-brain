# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=vayancy
POSTGRES_PASSWORD=vayancy
DATABASE_URL=postgresql://vayancy:vayancy@postgres:5432/agentic_brain

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── WebHotelier ──────────────────────────────────────────────────────────────
WEBHOTELIER_API_KEY=
WEBHOTELIER_PROPERTY_ID=
WEBHOTELIER_WEBHOOK_SECRET=
WEBHOTELIER_API_BASE=https://api.webhotelier.net/v2

# ─── WhatsApp Business Cloud API ─────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
OWNER_WHATSAPP_PHONE=+306912345678

# ─── HostHub (villa availability & pricing for public villa search) ────────────
# API key from HostHub dashboard → Settings → API
HOSTHUB_API_KEY=
# HostHub rental IDs for the 3 managed villas (encoded strings e.g. "w54dWRE")
HOSTHUB_RENTAL_ADAMAN=
HOSTHUB_RENTAL_BOAT=
HOSTHUB_RENTAL_NIDRI=

# ─── PriceLabs ────────────────────────────────────────────────────────────────
PRICELABS_API_KEY=
PRICELABS_PROPERTY_ID=

# ─── Epsilon Net (Greek tax / invoicing) ─────────────────────────────────────
EPSILON_NET_USERNAME=
EPSILON_NET_PASSWORD=
EPSILON_NET_COMPANY_ID=
EPSILON_NET_API_URL=https://api.epsilonnet.gr/v1

# ─── App ──────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-min-32-chars-for-admin-api
ENVIRONMENT=production
PROPERTY_ID=villa-azure
WORKER_JOB_TIMEOUT=300

# ─── TravelOS ─────────────────────────────────────────────────────────────────
TRAVELOS_COMMISSION_PCT=5.0

# ─── Grafana ──────────────────────────────────────────────────────────────────
# http://your-server:3001  →  admin / vayancy_grafana

# Stage 5 — Voyage AI (optional — replaces sentence-transformers)
# Get free key at https://dash.voyageai.com
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

# Stage 5 — WhatsApp HMAC verification (Meta App Secret)
# Found in Meta Developer Portal → App → Settings → Basic → App Secret
# Different from WHATSAPP_ACCESS_TOKEN
WHATSAPP_APP_SECRET=

# Stripe (exception payment flow)
# Only needed for tenants with payment_required=True (no booking engine)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
TRAVELOS_SUCCESS_URL=https://owners.vayancy.gr/booking/success
TRAVELOS_CANCEL_URL=https://owners.vayancy.gr/booking/cancel

# Email (Postmark — transactional confirmation emails)
# Get API key at https://postmarkapp.com — free tier = 100 emails/month
POSTMARK_API_KEY=
EMAIL_FROM_ADDRESS=bookings@vayancy.gr
EMAIL_FROM_NAME=Vayancy Bookings
EMAIL_REPLY_TO=support@vayancy.gr

# Optional overrides (defaults are fine for most deployments)
ANTHROPIC_MODEL=claude-opus-4-6
VOYAGE_DIMENSIONS=1024
WHATSAPP_API_BASE=https://graph.facebook.com/v20.0
PRICELABS_API_BASE=https://api.pricelabs.co/v1

# ─── Railway deployment — MCP server URLs ─────────────────────────────────────
# After deploying each MCP service on Railway, paste its public URL here.
# Leave as-is for local Docker Compose (uses internal Docker networking).
MCP_WEBHOTELIER_URL=http://mcp-webhotelier:3001/sse
MCP_WHATSAPP_URL=http://mcp-whatsapp:3002/sse
MCP_PRICELABS_URL=http://mcp-pricelabs:3003/sse
MCP_EPSILONNET_URL=http://mcp-epsilonnet:3004/sse
